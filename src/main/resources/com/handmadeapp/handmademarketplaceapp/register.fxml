<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane prefHeight="700" prefWidth="900"
           xmlns:fx="http://javafx.com/fxml/1"
           xmlns="http://javafx.com/javafx/21"
           fx:controller="com.handmadeapp.handmademarketplaceapp.RegisterController"
           stylesheets="@login.css">
    <HBox>

        <!-- ═══ LEFT PANEL ═══ -->
        <VBox styleClass="left-panel" prefWidth="380">

            <ImageView fx:id="logoImg"
                       fitWidth="180" fitHeight="180"
                       preserveRatio="true" pickOnBounds="true">
                <image>
                    <Image url="@sparkCraftLogo.png"/>
                </image>
            </ImageView>

            <Label text="SparkCraft"             styleClass="brand-name"/>
            <Label text="Handmade Marketplace"   styleClass="brand-sub"/>
            <Label text=" "/>
            <Label text="Join our community of artisans and handmade lovers."
                   styleClass="brand-tagline" wrapText="true"/>
        </VBox>

        <!-- ═══ RIGHT PANEL ═══ -->
        <VBox styleClass="right-panel" prefWidth="520">

            <Label text="Create Account"               styleClass="login-title"/>
            <Label text="Sign up to get started"       styleClass="login-subtitle"/>

            <!-- First / Last name -->
            <HBox spacing="10">
                <VBox styleClass="field-box" HBox.hgrow="ALWAYS">
                    <Label text="First Name" styleClass="field-label"/>
                    <TextField fx:id="firstNameField"
                               promptText="Enter first name"
                               styleClass="login-field"/>
                </VBox>
                <VBox styleClass="field-box" HBox.hgrow="ALWAYS">
                    <Label text="Last Name" styleClass="field-label"/>
                    <TextField fx:id="lastNameField"
                               promptText="Enter last name"
                               styleClass="login-field"/>
                </VBox>
            </HBox>

            <!-- Username -->
            <VBox styleClass="field-box">
                <Label text="Username" styleClass="field-label"/>
                <TextField fx:id="usernameField"
                           promptText="Choose a username"
                           styleClass="login-field"/>
            </VBox>

            <!-- Email -->
            <VBox styleClass="field-box">
                <Label text="Email" styleClass="field-label"/>
                <TextField fx:id="emailField"
                           promptText="Enter your email"
                           styleClass="login-field"/>
            </VBox>

            <!-- Role -->
            <VBox styleClass="field-box">
                <Label text="Account Type" styleClass="field-label"/>
                <ComboBox fx:id="roleCombo"
                          promptText="Select account type"
                          styleClass="login-field"/>
            </VBox>

            <!-- Password -->
            <VBox styleClass="field-box">
                <Label text="Password" styleClass="field-label"/>
                <PasswordField fx:id="passwordField"
                               promptText="Enter your password"
                               styleClass="login-field"/>
            </VBox>

            <!-- Confirm Password -->
            <VBox styleClass="field-box">
                <Label text="Confirm Password" styleClass="field-label"/>
                <PasswordField fx:id="confirmPasswordField"
                               promptText="Re-enter your password"
                               styleClass="login-field"/>
            </VBox>

            <Label fx:id="errorLabel"   text="" styleClass="error-label"/>
            <Label fx:id="successLabel" text="" styleClass="success-label"/>

            <Button fx:id="registerButton"
                    text="Create Account"
                    onAction="#handleRegister"
                    styleClass="login-btn"/>

            <Separator styleClass="login-separator"/>

            <HBox alignment="CENTER" spacing="5">
                <Label text="Already have an account?" styleClass="footer-label"/>
                <Button text="Login here"
                        onAction="#goToLogin"
                        styleClass="link-btn"/>
            </HBox>

        </VBox>
    </HBox>
</StackPane>
