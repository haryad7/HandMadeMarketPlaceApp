<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="720" prefWidth="1100"
            xmlns:fx="http://javafx.com/fxml/1"
            xmlns="http://javafx.com/javafx/21"
            fx:controller="com.handmadeapp.handmademarketplaceapp.OrderManagementController"
            stylesheets="@forms.css">

    <top>
        <HBox styleClass="topbar">
            <VBox>
                <Label text="Order Management"                styleClass="topbar-title"/>
                <Label text="Incoming orders for your shop"   styleClass="topbar-sub"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Refresh"        onAction="#loadOrders" styleClass="topbar-btn"/>
            <Button text="← Dashboard"    onAction="#goBack"     styleClass="topbar-btn"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="14">
            <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

            <!-- ═══ FILTER BAR ═══ -->
            <HBox spacing="10" alignment="CENTER_LEFT" styleClass="card">
                <Label text="Search"   styleClass="field-label"/>
                <TextField fx:id="searchField" promptText="Order #, buyer, or seller"
                           styleClass="form-field" prefWidth="240"/>
                <Label text="Status"   styleClass="field-label"/>
                <ComboBox fx:id="statusFilter" styleClass="form-field" prefWidth="160"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Apply"   onAction="#loadOrders" styleClass="primary-btn"/>
            </HBox>

            <!-- ═══ ORDERS TABLE ═══ -->
            <TableView fx:id="ordersTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colId"      text="Order #"   minWidth="80"/>
                    <TableColumn fx:id="colBuyer"   text="Buyer"     minWidth="150"/>
                    <TableColumn fx:id="colSeller"  text="Seller"    minWidth="150"/>
                    <TableColumn fx:id="colShop"    text="Shop"      minWidth="160"/>
                    <TableColumn fx:id="colTotal"   text="Total"     minWidth="90"/>
                    <TableColumn fx:id="colDate"    text="Date"      minWidth="150"/>
                    <TableColumn fx:id="colStatus"  text="Status"    minWidth="110"/>
                    <TableColumn fx:id="colAddress" text="Ship To"   minWidth="200"/>
                </columns>
            </TableView>

            <!-- ═══ ACTION BAR ═══ -->
            <HBox spacing="10" alignment="CENTER_LEFT" styleClass="card">
                <Label text="Update selected order to:" styleClass="field-label"/>
                <ComboBox fx:id="newStatusBox" styleClass="form-field" prefWidth="160"/>
                <Button text="Update Status" onAction="#updateStatus" styleClass="primary-btn"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="statusMsg" text="" styleClass="info-label"/>
            </HBox>
        </VBox>
    </center>
</BorderPane>
