<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.geometry.Pos?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="720" prefWidth="1000"
            xmlns:fx="http://javafx.com/fxml/1"
            xmlns="http://javafx.com/javafx/21"
            fx:controller="com.handmadeapp.handmademarketplaceapp.OrderConfirmationController"
            stylesheets="@forms.css">

    <top>
        <HBox styleClass="topbar">
            <VBox>
                <Label text="Order Confirmation" styleClass="topbar-title"/>
                <Label text="Step 3 of 3"        styleClass="topbar-sub"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Back to Dashboard" onAction="#goDashboard" styleClass="topbar-btn"/>
        </HBox>
    </top>

    <center>
        <HBox spacing="20" alignment="TOP_CENTER">
            <padding><Insets top="24" right="24" bottom="24" left="24"/></padding>

            <!-- ═══ SUCCESS CARD ═══ -->
            <VBox styleClass="card" spacing="14" alignment="CENTER" prefWidth="420">
                <Label text="✓"                                styleClass="success-check"/>
                <Label text="Thank you for your order!"        styleClass="card-title"/>
                <Label fx:id="orderNumberLabel" text="Order #—" styleClass="info-label"/>
                <Label fx:id="totalPaidLabel"   text="Total: $0.00" styleClass="summary-total"
                       style="-fx-text-fill: #1d2d6b;"/>
                <Label text="Confirmation email is on its way." styleClass="success-badge"/>
                <Region prefHeight="6"/>
                <Label text="What happens next?"               styleClass="section-label"/>
                <Label wrapText="true" styleClass="info-label" maxWidth="320"
                       text="The seller will prepare your item and ship it. You can track the status from the 'My Orders' screen."/>
                <HBox spacing="10" alignment="CENTER">
                    <Button text="View My Orders" onAction="#goMyOrders" styleClass="secondary-btn"/>
                    <Button text="Continue Shopping" onAction="#goDashboard" styleClass="primary-btn"/>
                </HBox>
            </VBox>

            <!-- ═══ REVIEW CARD ═══ -->
            <VBox styleClass="card" spacing="12" prefWidth="420">
                <Label text="Leave a quick review"   styleClass="card-title"/>
                <Label text="How was your experience?" styleClass="info-label"/>

                <HBox fx:id="starsBox" spacing="4" alignment="CENTER_LEFT">
                    <Button fx:id="star1" text="★" onAction="#rate1" styleClass="star-btn"/>
                    <Button fx:id="star2" text="★" onAction="#rate2" styleClass="star-btn"/>
                    <Button fx:id="star3" text="★" onAction="#rate3" styleClass="star-btn"/>
                    <Button fx:id="star4" text="★" onAction="#rate4" styleClass="star-btn"/>
                    <Button fx:id="star5" text="★" onAction="#rate5" styleClass="star-btn"/>
                </HBox>

                <Label text="Your comment" styleClass="field-label"/>
                <TextArea fx:id="commentArea"
                          promptText="Tell other buyers what you thought…"
                          styleClass="form-field" wrapText="true"/>

                <Label fx:id="reviewMsg" text="" styleClass="info-label"/>

                <HBox spacing="10">
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="Skip"          onAction="#handleSkipReview"   styleClass="secondary-btn"/>
                    <Button text="Submit Review" onAction="#handleSubmit"  styleClass="primary-btn"/>
                </HBox>
            </VBox>
        </HBox>
    </center>
</BorderPane>
