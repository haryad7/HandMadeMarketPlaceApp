<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>

<HBox prefHeight="700" prefWidth="1150"
      stylesheets="@dashboard.css"
      xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.handmadeapp.handmademarketplaceapp.ShopManagementController">

    <!-- ═══ SIDEBAR ═══ -->
    <VBox prefWidth="240" minWidth="240" styleClass="sidebar">
        <VBox styleClass="sidebar-brand" spacing="8">
            <ImageView fitWidth="52" fitHeight="52" preserveRatio="true">
                <image><Image url="@sparkCraftLogo.png"/></image>
            </ImageView>
            <Label text="SparkCraft"           styleClass="sidebar-brand-title"/>
            <Label text="Handmade Marketplace" styleClass="sidebar-brand-sub"/>
        </VBox>
        <Separator styleClass="sidebar-sep"/>
        <VBox styleClass="sidebar-user" spacing="6">
            <Label fx:id="userNameLabel" text="..." styleClass="sidebar-user-name"/>
            <Label text="SELLER" styleClass="role-badge role-badge-seller"/>
        </VBox>
        <Separator styleClass="sidebar-sep"/>
        <VBox styleClass="nav-area" spacing="2" VBox.vgrow="ALWAYS">
            <Label text="SELLER" styleClass="nav-section-label"/>
            <Button text="  My Shop"         onAction="#goShop"              styleClass="nav-btn nav-btn-active" maxWidth="Infinity"/>
            <Button text="  Manage Products" onAction="#goProductManagement" styleClass="nav-btn" maxWidth="Infinity"/>
            <Button text="  Inventory"       onAction="#goInventory"         styleClass="nav-btn" maxWidth="Infinity"/>
            <Button text="  Order Mgmt"      onAction="#goOrderManagement"   styleClass="nav-btn" maxWidth="Infinity"/>
            <Button text="  Messages"        onAction="#goMessages"          styleClass="nav-btn" maxWidth="Infinity"/>
        </VBox>
        <VBox styleClass="sidebar-footer">
            <Button text="← Dashboard" onAction="#goDashboard" styleClass="logout-btn" maxWidth="Infinity"/>
        </VBox>
    </VBox>

    <!-- ═══ MAIN CONTENT ═══ -->
    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="main-scroll" HBox.hgrow="ALWAYS">
        <VBox styleClass="main-content" spacing="28">

            <Label text="My Shop" styleClass="welcome-title"/>

            <!-- Banner preview -->
            <VBox styleClass="section-card" spacing="12">
                <Label text="Shop Banner" styleClass="section-heading"/>
                <VBox styleClass="banner-preview" prefHeight="120" alignment="CENTER">
                    <Label fx:id="bannerPreviewLabel" text="No banner set — enter a URL below"
                           styleClass="banner-placeholder"/>
                </VBox>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <TextField fx:id="bannerUrlField" promptText="Banner image URL (optional)"
                               styleClass="login-field" HBox.hgrow="ALWAYS"/>
                    <Button text="Preview" onAction="#handleBannerPreview" styleClass="topbar-btn"/>
                </HBox>
            </VBox>

            <!-- Shop profile form -->
            <VBox styleClass="section-card" spacing="16">
                <Label text="Shop Profile" styleClass="section-heading"/>

                <HBox spacing="20">
                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <Label text="Shop Name *" styleClass="field-label"/>
                        <TextField fx:id="shopNameField" promptText="Your shop name"
                                   styleClass="login-field" maxWidth="Infinity"/>
                    </VBox>
                    <VBox spacing="6" prefWidth="180">
                        <Label text="Status" styleClass="field-label"/>
                        <ComboBox fx:id="shopStatusCombo" styleClass="filter-combo" maxWidth="Infinity"/>
                    </VBox>
                </HBox>

                <VBox spacing="6">
                    <Label text="URL Slug" styleClass="field-label"/>
                    <TextField fx:id="shopSlugField" promptText="e.g. my-craft-shop"
                               styleClass="login-field" maxWidth="Infinity"/>
                </VBox>

                <VBox spacing="6">
                    <Label text="Shop Bio / Description" styleClass="field-label"/>
                    <TextArea fx:id="shopDescField" promptText="Tell buyers about your shop…"
                              styleClass="form-textarea" prefRowCount="4" wrapText="true" maxWidth="Infinity"/>
                </VBox>

                <HBox spacing="12" alignment="CENTER_RIGHT">
                    <Label fx:id="saveFeedbackLabel" text="" styleClass="feedback-label"/>
                    <Button text="Save Changes" onAction="#handleSave" styleClass="add-to-cart-btn"/>
                </HBox>
            </VBox>

        </VBox>
    </ScrollPane>
</HBox>
