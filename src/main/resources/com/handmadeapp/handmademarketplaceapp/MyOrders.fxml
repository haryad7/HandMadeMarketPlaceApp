<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="720" prefWidth="1100"
            xmlns:fx="http://javafx.com/fxml/1"
            xmlns="http://javafx.com/javafx/21"
            fx:controller="com.handmadeapp.handmademarketplaceapp.MyOrdersController"
            stylesheets="@forms.css">

    <top>
        <HBox styleClass="topbar">
            <VBox>
                <Label text="My Orders" styleClass="topbar-title"/>
                <Label text="Your marketplace purchase history" styleClass="topbar-sub"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Browse" onAction="#goBrowseProducts" styleClass="topbar-btn"/>
            <Button text="Cart" onAction="#goCart" styleClass="topbar-btn"/>
            <Button text="Messages" onAction="#goMessages" styleClass="topbar-btn"/>
            <Button text="Dashboard" onAction="#goDashboard" styleClass="topbar-btn"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="14">
            <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

            <HBox spacing="10" alignment="CENTER_LEFT" styleClass="card">
                <Label text="Search" styleClass="field-label"/>
                <TextField fx:id="searchField" promptText="Order # or shop name"
                           styleClass="form-field" prefWidth="240"/>
                <Label text="Status" styleClass="field-label"/>
                <ComboBox fx:id="statusFilter" styleClass="form-field" prefWidth="160"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Apply" onAction="#loadOrders" styleClass="primary-btn"/>
            </HBox>

            <TableView fx:id="ordersTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colId" text="Order #" prefWidth="80"/>
                    <TableColumn fx:id="colShop" text="Shop" prefWidth="180"/>
                    <TableColumn fx:id="colTotal" text="Total" prefWidth="100"/>
                    <TableColumn fx:id="colDate" text="Date" prefWidth="170"/>
                    <TableColumn fx:id="colStatus" text="Status" prefWidth="120"/>
                    <TableColumn fx:id="colAddress" text="Ship To" prefWidth="260"/>
                </columns>
                <placeholder>
                    <Label text="No orders found."/>
                </placeholder>
            </TableView>

            <HBox alignment="CENTER_LEFT" styleClass="card">
                <Label fx:id="statusMsg" text="" styleClass="info-label"/>
            </HBox>
        </VBox>
    </center>
</BorderPane>
